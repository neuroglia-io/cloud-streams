@namespace CloudStreams.Dashboard.Pages.CloudEvents.Search
@page "/events/search"
@using CloudStreams.Core.Resources
@using Neuroglia.Serialization
@inject ICloudStreamsCoreApiClient ApiClient
@inject IJsonSerializer Serializer

<ApplicationTitle>Search events</ApplicationTitle>

<form class="mb-3" @onsubmit="SearchAsync" @onsubmit:preventDefault>
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label small" for="search-partition-type">Partition</label>
            <select id="search-partition-type" class="form-select form-select-sm" @bind="partitionType">
                <option value="">The whole stream</option>
                <option value="@CloudEventPartitionType.BySource">By source</option>
                <option value="@CloudEventPartitionType.ByType">By type</option>
                <option value="@CloudEventPartitionType.BySubject">By subject</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="search-partition-id">Partition id</label>
            <input id="search-partition-id" class="form-control form-control-sm" disabled="@(partitionType == null)" @bind="partitionId" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="search-from">From</label>
            <input id="search-from" type="datetime-local" class="form-control form-control-sm" @bind="from" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="search-to">To</label>
            <input id="search-to" type="datetime-local" class="form-control form-control-sm" @bind="to" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="search-id">Id</label>
            <input id="search-id" class="form-control form-control-sm" placeholder="Exact id" @bind="id" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="search-source">Source</label>
            <input id="search-source" class="form-control form-control-sm" placeholder="Regular expression" @bind="source" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="search-type">Type</label>
            <input id="search-type" class="form-control form-control-sm" placeholder="Regular expression" @bind="type" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="search-subject">Subject</label>
            <input id="search-subject" class="form-control form-control-sm" placeholder="Regular expression" @bind="subject" />
        </div>
        <div class="col-md-9">
            <label class="form-label small" for="search-expression">Expression</label>
            <input id="search-expression" class="form-control form-control-sm font-monospace" placeholder="A jq condition on the record, e.g. .data.total > 100" @bind="expression" />
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-sm btn-primary" disabled="@searching"><Icon Name="IconName.Search" /> Search</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Reset">Reset</button>
        </div>
    </div>
</form>

@if (error != null)
{
    <Callout Type="CalloutType.Danger">@error</Callout>
}
@if (records != null)
{
    <div class="small text-secondary mb-2" role="status">
        @records.Count match@(records.Count == 1 ? "" : "es") in @scanned record@(scanned == 1 ? "" : "s") read@(nextOffset.HasValue ? $", up to offset {nextOffset - 1}" : ", up to the end")
    </div>
    <div class="table-container">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th class="sticky-header">Offset</th>
                    <th class="sticky-header">Id</th>
                    <th class="sticky-header">Recorded</th>
                    <th class="sticky-header">Source</th>
                    <th class="sticky-header">Type</th>
                    <th class="sticky-header">Subject</th>
                </tr>
            </thead>
            <tbody>
                @if (records.Count == 0)
                {
                    <tr><td colspan="6" class="text-secondary">No cloud event matched.</td></tr>
                }
                @foreach (var (record, e) in records)
                {
                    <tr class="cursor-pointer" @onclick="() => ShowDetailsAsync(record, e)">
                        <td>@record.Sequence</td>
                        <td>@e.Id</td>
                        <td>@record.Timestamp?.LocalDateTime</td>
                        <td>@e.Source</td>
                        <td>@e.Type</td>
                        <td>@e.Subject</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (nextOffset.HasValue)
    {
        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@searching" @onclick="LoadMoreAsync">Continue the search</button>
    }
}

<Offcanvas @ref="offcanvas" Size="OffcanvasSize.Large" UseStaticBackdrop="false" />

@code {

    CloudEventPartitionType? partitionType;
    string? partitionId;
    DateTime? from;
    DateTime? to;
    string? id;
    string? source;
    string? type;
    string? subject;
    string? expression;
    CloudEventSearchOptions? options;
    List<(CloudEventRecord Record, CloudEvent Event)>? records;
    int scanned;
    ulong? nextOffset;
    bool searching;
    string? error;
    Offcanvas? offcanvas;

    async Task SearchAsync()
    {
        var attributes = new Dictionary<string, string>();
        if (!string.IsNullOrWhiteSpace(this.source)) attributes[CloudEventAttributes.Source] = this.source.Trim();
        if (!string.IsNullOrWhiteSpace(this.type)) attributes[CloudEventAttributes.Type] = this.type.Trim();
        if (!string.IsNullOrWhiteSpace(this.subject)) attributes[CloudEventAttributes.Subject] = this.subject.Trim();
        this.options = new()
        {
            PartitionType = string.IsNullOrWhiteSpace(this.partitionId) ? null : this.partitionType,
            PartitionId = this.partitionType == null || string.IsNullOrWhiteSpace(this.partitionId) ? null : this.partitionId.Trim(),
            From = this.from.HasValue ? new DateTimeOffset(this.from.Value) : null,
            To = this.to.HasValue ? new DateTimeOffset(this.to.Value) : null,
            Id = string.IsNullOrWhiteSpace(this.id) ? null : this.id.Trim(),
            Attributes = attributes.Count > 0 ? attributes : null,
            Expression = string.IsNullOrWhiteSpace(this.expression) ? null : this.expression.Trim(),
            MaxResults = 50
        };
        this.records = [];
        this.scanned = 0;
        this.nextOffset = null;
        await this.RunAsync(this.options);
    }

    Task LoadMoreAsync() => this.options == null || !this.nextOffset.HasValue ? Task.CompletedTask : this.RunAsync(this.options with { Offset = this.nextOffset });

    async Task RunAsync(CloudEventSearchOptions options)
    {
        this.searching = true;
        this.error = null;
        try
        {
            var result = await this.ApiClient.CloudEvents.SearchAsync(options);
            this.records ??= [];
            this.records.AddRange(result.Records.Select(r => (r, r.ToCloudEvent(this.Serializer))));
            this.scanned += result.Scanned;
            this.nextOffset = result.NextOffset;
        }
        catch (Exception ex)
        {
            this.error = ex is Neuroglia.ProblemDetailsException problem ? problem.Problem.Detail ?? problem.Problem.Title : ex.Message;
        }
        finally { this.searching = false; }
    }

    void Reset()
    {
        this.partitionType = null;
        this.partitionId = this.id = this.source = this.type = this.subject = this.expression = null;
        this.from = this.to = null;
        this.options = null;
        this.records = null;
        this.error = null;
    }

    Task ShowDetailsAsync(CloudEventRecord record, CloudEvent e)
    {
        if (this.offcanvas == null) return Task.CompletedTask;
        var parameters = new Dictionary<string, object>() { ["ReadOnly"] = true, ["CloudEvent"] = e, ["Offset"] = (ulong?)record.Sequence };
        if (this.options?.PartitionType is CloudEventPartitionType partition) parameters["Partition"] = new PartitionReference(partition, this.options.PartitionId!);
        return this.offcanvas.ShowAsync<CloudEventDetails>(title: "Cloud Event Details", parameters: parameters);
    }

}
