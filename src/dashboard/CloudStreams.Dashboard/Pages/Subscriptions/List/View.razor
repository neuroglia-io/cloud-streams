@namespace CloudStreams.Dashboard.Pages.Subscriptions.List
@page "/subscriptions"
@using CloudStreams.Core.Api.Client.Services;
@using Json.Patch;
@using Json.Pointer;
@using Neuroglia.Data
@inherits ResourceManagementComponent<View, SubscriptionListStore, SubscriptionListState, Subscription>
@inject ICloudStreamsCoreApiClient ApiClient;

<ApplicationTitle>Subscriptions</ApplicationTitle>

<div class="table-container">
    @if (Loading)
    {
        <div class="loading">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    <ResourceListToolbar Id="subscriptions" Title="Subscriptions" Count="Resources?.Count ?? 0" SelectedCount="SelectedResourceNames.Count" SearchTerm="@SearchTerm" OnSearch="term => Store.SetSearchTerm(term)"
                         LabelSelector="@LabelSelector" LabelSelectorError="@LabelSelectorError" OnLabelSelector="OnLabelSelector" CanAdminister="CanAdminister"
                         OnImport="OnImportAsync" OnExportSelected="OnExportSelectedResourcesAsync" OnDeleteSelected="OnDeleteSelectedResourcesAsync" />
    <table class="table table-striped table-hover">
        <caption class="visually-hidden">Subscriptions. Select a row, or press Enter on it, to see its details. Rows of subscriptions that are behind their stream are highlighted, and their length is marked as behind.</caption>
        <thead>
            <tr>
                <SortableHeader Column="@ResourceSortColumns.Name" Title="Name" SortColumn="@SortColumn" Descending="SortDescending" OnSort="OnSort" />
                @if (ShowNamespace)
                {
                    <th class="sticky-header">Namespace</th>
                }
                <SortableHeader Column="@ResourceSortColumns.Created" Title="Created At" SortColumn="@SortColumn" Descending="SortDescending" OnSort="OnSort" CssClass="text-center" />
                <SortableHeader Column="phase" Title="Status" SortColumn="@SortColumn" Descending="SortDescending" OnSort="OnSort" CssClass="text-center" />
                <th class="sticky-header text-center">Subscriber</th>
                <SortableHeader Column="subscriber" Title="Subscriber Status" SortColumn="@SortColumn" Descending="SortDescending" OnSort="OnSort" CssClass="text-center" />
                <th class="sticky-header text-center">Rate Limit</th>
                <th class="sticky-header text-center">Partition Type</th>
                <th class="sticky-header text-center">Partition ID</th>
                <th class="sticky-header text-center">Filter</th>
                <th class="sticky-header text-center">Stream</th>
                <th class="sticky-header text-center">Mutate</th>
                <th class="sticky-header text-center">Offset</th>
                <th class="sticky-header text-center">Length</th>
                <th class="sticky-header"><span class="visually-hidden">Actions</span></th>
                <th class="sticky-header text-center align-middle">
                    <input @ref="CheckboxAll" type="checkbox" aria-label="Select all subscriptions" @onclick="(_) => Store.ToggleResourceSelection()" @onclick:preventDefault="true" @onclick:stopPropagation="true" />
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Resources?.Count > 0)
            {
                <Virtualize Context="resource" Items="@Resources">
                    @{
                        var streamLength = subscriptionLengths.Keys.Contains(resource.GetName()) ? subscriptionLengths[resource.GetName()] : (ulong)0;
                    }
                    <tr @onclick="async _ => await OnShowResourceDetailsAsync(resource)" @onkeydown="e => OnActivationKeyDown(e, () => OnShowResourceDetailsAsync(resource))" tabindex="0" class="cursor-pointer @(IsBehind(resource, streamLength) ? "warning-row" : "")">
                        <td><a href="@($"subscriptions/{Uri.EscapeDataString(resource.GetNamespace() ?? Neuroglia.Data.Infrastructure.ResourceOriented.Namespace.DefaultNamespaceName)}/{Uri.EscapeDataString(resource.GetName())}")" @onclick:stopPropagation="true" title="Open the details page of the subscription">@resource.Metadata.Name</a></td>
                        @if (ShowNamespace)
                        {
                            <td>@resource.GetNamespace()</td>
                        }
                        <td class="text-center">@resource.Metadata.CreationTimestamp?.LocalDateTime.ToString("g")</td>
                        <td class="text-center">
                            @switch (resource.Status?.Phase)
                            {
                                case SubscriptionStatusPhase.Active:
                                    <span class="badge text-dark bg-primary">active</span>
                                    break;
                                case SubscriptionStatusPhase.Inactive:
                                    <span class="badge bg-secondary">inactive</span>
                                    break;
                                case SubscriptionStatusPhase.Suspended:
                                    <span class="badge text-dark bg-warning" title="Nothing is delivered until the subscription is resumed">suspended</span>
                                    break;
                            }
                            @if(resource.Status?.Stream?.Fault != null)
                            {
                                @if (CanOperate)
                                {
                                    <button type="button" class="badge text-dark bg-danger border-0 ms-1" title="@($"{resource.Status.Stream.Fault} (click to resume)")" aria-label="@($"Subscription '{resource.Metadata.Name}' is faulted: resume it")" @onclick="async e => await OnResumeSubscriptionAsync(resource)" @onclick:preventDefault="true" @onclick:stopPropagation="true">faulted</button>
                                }
                                else
                                {
                                    <span class="badge text-dark bg-danger ms-1" title="@resource.Status.Stream.Fault">faulted</span>
                                }
                            }
                        </td>
                        <td class="text-center">
                            <DeliveryTargetDisplay Endpoint="resource.Spec.Subscriber.Endpoint" Sink="@resource.Spec.Subscriber.Sink" />
                        </td>
                        <td class="text-center">
                            <span class="badge @GetSubscriberStatusClass(resource)">
                                @((resource.Status?.Subscriber?.State ?? SubscriberState.Unknown).ToString().ToLower())
                            </span>
                        </td>
                        <td class="text-center">@(resource.Spec.Subscriber.RateLimit.HasValue ? resource.Spec.Subscriber.RateLimit.Value.ToString() : "-")</td>
                        <td class="text-center">@resource.Spec?.Partition?.Type</td>
                        <td class="text-center">@resource.Spec?.Partition?.Id</td>
                        <td class="text-center">
                            @if (resource.Spec?.Filter == null)
                            {
                                <span class="badge bg-secondary">no</span>
                            }
                            else
                            {
                                <span class="badge text-dark bg-primary">yes</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (resource.Spec?.Stream == null)
                            {
                                <span class="badge bg-secondary">no</span>
                            }
                            else
                            {
                                <span class="badge text-dark bg-primary">yes</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (resource.Spec?.Mutation == null)
                            {
                                <span class="badge bg-secondary">no</span>
                            }
                            else
                            {
                                <span class="badge text-dark bg-primary">yes</span>
                            }
                        </td>
                        <td class="text-center">@(resource.Spec?.Stream == null ? "-" : resource.Status == null || resource.Status?.Stream == null ? "" : resource.Status?.Stream?.AckedOffset)</td>
                        <td class="text-center">
                            @streamLength
                            @if (IsBehind(resource, streamLength))
                            {
                                <span class="badge text-bg-warning ms-1" title="The subscription has not acknowledged every event of its stream">behind by @(streamLength - (resource.Status?.Stream?.AckedOffset ?? 0))</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@($"Actions on the subscription '{resource.Metadata.Name}'")" @onclick:stopPropagation="true"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                                <ul class="dropdown-menu">
                                    @if (CanOperate)
                                    {
                                        @* a faulted subscription is resumed too, which clears its fault and retries the event that caused it *@
                                        @if (resource.Spec?.Suspended == true || resource.Status?.Stream?.Fault != null)
                                        {
                                            <li>
                                                <button class="dropdown-item" title="@(resource.Status?.Stream?.Fault != null ? $"Clear the fault of the subscription '{resource.Metadata.Name}', and retry the event that caused it" : $"Resume delivering events to the subscriber of the subscription '{resource.Metadata.Name}', where it stopped")" @onclick="async _ => await OnResumeSubscriptionAsync(resource)" @onclick:preventDefault @onclick:stopPropagation><Icon Name="IconName.PlayFill" /> Resume</button>
                                            </li>
                                        }
                                        @if (resource.Spec?.Suspended != true)
                                        {
                                            <li>
                                                <button class="dropdown-item" title="Stop delivering events to the subscriber of the subscription '@resource.Metadata.Name' until it is resumed" @onclick="async _ => await OnSuspendSubscriptionAsync(resource)" @onclick:preventDefault @onclick:stopPropagation><Icon Name="IconName.PauseFill" /> Suspend</button>
                                            </li>
                                        }
                                        <li>
                                            <button class="dropdown-item" title="Replay all events matching @(typeof(Subscription).Name.ToLower()) '@resource.Metadata.Name', which implicitly enables streaming." @onclick="async _ => await OnRestartSubscriptionAsync(resource)" @onclick:preventDefault @onclick:stopPropagation><Icon Name="IconName.ArrowClockwise" /> Replay</button>
                                        </li>
                                    }
                                    <li>
                                        <button class="dropdown-item" title="Export the subscription '@resource.Metadata.Name'" @onclick="async _ => await OnExportAsync([resource])" @onclick:preventDefault @onclick:stopPropagation><Icon Name="IconName.Download" /> Export</button>
                                    </li>
                                    @if (CanAdminister)
                                    {
                                        <li>
                                            <button class="dropdown-item" title="Edit the @(typeof(Subscription).Name.ToLower()) '@resource.Metadata.Name'" @onclick="async _ => await OnShowResourceEditorAsync(resource)" @onclick:preventDefault @onclick:stopPropagation><Icon Name="IconName.Pencil" /> Edit</button>
                                        </li>
                                    }
                                    @if (CanAdminister)
                                    {
                                        <li>
                                            <button class="dropdown-item text-danger" title="Delete the @(typeof(Subscription).Name.ToLower()) '@resource.Metadata.Name'" @onclick="async _ => await OnDeleteResourceAsync(resource)" @onclick:preventDefault @onclick:stopPropagation><Icon Name="IconName.Trash" /> Delete</button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                        <td class="text-center align-middle">
                            <input type="checkbox" aria-label="@($"Select the subscription '{resource.Metadata.Name}'")" @onkeydown:stopPropagation="true" checked="@SelectedResourceNames.Contains(resource.GetQualifiedName())" @onclick="(_) => Store.ToggleResourceSelection(resource.GetQualifiedName())" @onclick:preventDefault="true" @onclick:stopPropagation="true" />
                        </td>
                    </tr>
                </Virtualize>
            }
        </tbody>
    </table>
</div>

@if (CanAdminister)
{
    <Button Outline="true" Color="ButtonColor.Primary" @onclick="async _ => await OnShowResourceEditorAsync()" aria-label="Create a subscription" title="Create a subscription"><Icon Name="IconName.Plus" /></Button>
}
<a class="btn btn-outline-secondary ms-1" href="playground" title="Try a filter and a mutation against recent or sample events"><i class="bi bi-funnel" aria-hidden="true"></i> Playground</a>

<Offcanvas @ref="DetailsOffCanvas" Size="OffcanvasSize.Large" UseStaticBackdrop="false" BodyCssClass="d-flex flex-column" />

<Offcanvas @ref="EditorOffCanvas" Size="OffcanvasSize.Large" UseStaticBackdrop="false" BodyCssClass="d-flex flex-column" />

<CloudStreams.Dashboard.Components.ResourceForms.ResourceFormModal @ref="FormModal" />

<ConfirmDialog @ref="Dialog" />

@code
{
    /// <inheritdoc/>
    protected override Task? ShowFormAsync(Subscription? resource) => ShowFormAsync<CloudStreams.Dashboard.Pages.Subscriptions.Form.SubscriptionForm>(resource);

    EquatableDictionary<string, ulong> subscriptionLengths = [];

    /// <inheritdoc/>
    protected override void ConfigureSortKeys(IDictionary<string, Func<Subscription, IComparable?>> sortKeys)
    {
        // faulted subscriptions come first, then suspended, inactive and active ones
        sortKeys["phase"] = s => s.Status?.Stream?.Fault != null ? 0 : s.Status?.Phase switch
        {
            SubscriptionStatusPhase.Suspended => 1,
            SubscriptionStatusPhase.Inactive => 2,
            SubscriptionStatusPhase.Active => 3,
            _ => 4
        };
        sortKeys["subscriber"] = s => (s.Status?.Subscriber?.State ?? SubscriberState.Unknown) switch
        {
            SubscriberState.Unreachable => 0,
            SubscriberState.Unknown => 1,
            _ => 2
        };
    }

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        Store.SubscriptionLengths.Subscribe(value => OnStateChanged(_ => subscriptionLengths = value), CancellationTokenSource.Token);
        await base.OnInitializedAsync().ConfigureAwait(false);
    }

    /// <summary>
    /// Determines whether the specified subscription is behind the stream or partition it consumes
    /// </summary>
    /// <remarks>Only subscriptions that track an offset can be behind: their acknowledged offset is the offset of the next event to deliver (see #196)</remarks>
    static bool IsBehind(Subscription subscription, ulong streamLength) => subscription.Spec.Stream != null && (subscription.Status?.Stream?.AckedOffset ?? 0) < streamLength;

    async Task OnSuspendSubscriptionAsync(Subscription subscription)
    {
        if (Dialog == null) return;
        var confirmed = await Dialog.ShowAsync(
            title: $"Suspend subscription '{subscription.Metadata.Name}'?",
            message1: "Nothing is delivered to the subscriber until the subscription is resumed.",
            message2: subscription.Spec.Stream == null ? "The subscription does not track an offset: the events published while it is suspended are not delivered once it is resumed." : "Delivery resumes where it stopped.",
            confirmDialogOptions: new ConfirmDialogOptions() { YesButtonText = "Suspend", YesButtonColor = ButtonColor.Warning, NoButtonText = "Cancel", IsVerticallyCentered = true });
        if (!confirmed) return;
        try
        {
            await this.ApiClient.Resources.Subscriptions.SuspendAsync(subscription.GetName(), subscription.GetNamespace());
            NotifySuccess($"The subscription '{subscription.Metadata.Name}' has been suspended");
        }
        catch (Exception ex)
        {
            NotifyFailure($"Failed to suspend the subscription '{subscription.Metadata.Name}'", ex);
        }
    }

    async Task OnResumeSubscriptionAsync(Subscription subscription)
    {
        if (Dialog == null) return;
        var fault = subscription.Status?.Stream?.Fault;
        var title = $"Resume subscription '{subscription.Metadata.Name}'?";
        var options = new ConfirmDialogOptions() { YesButtonText = "Resume", NoButtonText = "Cancel", IsVerticallyCentered = true };
        var confirmed = fault == null
            ? await Dialog.ShowAsync(title, "The subscription is suspended: delivery resumes where it stopped.", options)
            : await Dialog.ShowAsync<FaultSummary>(title, new Dictionary<string, object>() { [nameof(FaultSummary.Fault)] = fault, [nameof(FaultSummary.Suspended)] = subscription.Spec.Suspended }, new ConfirmDialogOptions() { YesButtonText = "Resume", NoButtonText = "Cancel", IsVerticallyCentered = true, Size = DialogSize.Large });
        if (!confirmed) return;
        try
        {
            // a dedicated endpoint rather than a status patch, which only administrators may send (see #147)
            await this.ApiClient.Resources.Subscriptions.ResumeAsync(subscription.GetName(), subscription.GetNamespace());
            NotifySuccess($"The subscription '{subscription.Metadata.Name}' has been resumed");
        }
        catch (Exception ex)
        {
            NotifyFailure($"Failed to resume the subscription '{subscription.Metadata.Name}'", ex);
        }
    }

    /// <remarks>
    /// Replayed by a dedicated endpoint, which operators may call without being allowed to patch the subscription (see #147)
    /// </remarks>
    async Task OnRestartSubscriptionAsync(Subscription subscription)
    {
        if (Dialog == null) return;
        var confirmed = await Dialog.ShowAsync(
            title: $"Replay subscription '{subscription.Metadata.Name}'?",
            message1: "Every event matching the subscription will be delivered again, from the beginning of the stream.",
            confirmDialogOptions: new ConfirmDialogOptions() { YesButtonText = "Replay", YesButtonColor = ButtonColor.Warning, NoButtonText = "Cancel", IsVerticallyCentered = true });
        if (!confirmed) return;
        try
        {
            await this.ApiClient.Resources.Subscriptions.ReplayAsync(subscription.GetName(), @namespace: subscription.GetNamespace());
            NotifySuccess($"The subscription '{subscription.Metadata.Name}' is being replayed");
        }
        catch (Exception ex)
        {
            NotifyFailure($"Failed to replay the subscription '{subscription.Metadata.Name}'", ex);
        }
    }

    string GetSubscriberStatusClass(Subscription subscription) => subscription?.Status?.Subscriber?.State switch
    {
        SubscriberState.Unknown => "bg-secondary",
        SubscriberState.Reachable => "text-dark bg-primary",
        SubscriberState.Unreachable => "bg-danger",
        _ => "bg-secondary"
    };
}