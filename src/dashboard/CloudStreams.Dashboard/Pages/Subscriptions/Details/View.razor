@namespace CloudStreams.Dashboard.Pages.Subscriptions.Details
@page "/subscriptions/{Name}"
@page "/subscriptions/{Namespace}/{Name}"
@using CloudStreams.Core.Resources
@using Neuroglia.Data.Infrastructure.EventSourcing
@using System.Globalization
@implements IDisposable
@inject ICloudStreamsCoreApiClient Api
@inject UserAccess UserAccess
@inject ToastService ToastService

@* The details of a subscription: its state, its lag and acknowledgement rate while the page is open, its fault, its failure history, and a playground (see #224) *@

<ApplicationTitle>@($"Subscription {Name}")</ApplicationTitle>

<div class="container-fluid px-0">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-2">
            <li class="breadcrumb-item"><a href="subscriptions">Subscriptions</a></li>
            <li class="breadcrumb-item active" aria-current="page">@SubscriptionNamespace / @Name</li>
        </ol>
    </nav>

    @if (notFound)
    {
        <div class="alert alert-warning" role="alert">There is no subscription named '@Name'.</div>
    }
    else if (subscription == null)
    {
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
    }
    else
    {
        var fault = subscription.Status?.Stream?.Fault;
        var faultedOffset = subscription.Status?.Stream?.FaultedOffset;
        var pendingAck = subscription.Status?.Subscriber?.PendingAck;
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0 me-2">@Name</h2>
            @PhaseBadge(subscription)
            @if (canOperate)
            {
                <div class="ms-auto d-flex gap-2">
                    @if (subscription.Spec.Suspended)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ResumeAsync"><i class="bi bi-play-fill" aria-hidden="true"></i> Resume</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SuspendAsync"><i class="bi bi-pause-fill" aria-hidden="true"></i> Suspend</button>
                    }
                </div>
            }
        </div>

        @if (health?.ExpiredEvents > 0)
        {
            <div class="alert alert-warning small" role="status">
                <i class="bi bi-hourglass-bottom" aria-hidden="true"></i>
                <strong>@health.ExpiredEvents.Value.ToString("N0") event(s) expired</strong> before this subscription delivered them: the retention policy of the stream removed them, and it will never receive them.
            </div>
        }
        @if (fault != null)
        {
            <section class="alert alert-danger" aria-labelledby="fault-title">
                <h3 id="fault-title" class="h6 alert-heading"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Faulted: delivery is stopped</h3>
                <p class="mb-2 text-break">@(fault.Detail ?? fault.Title)</p>
                <p class="small mb-2">
                    @if (faultedOffset.HasValue)
                    {
                        <text>Caused by the event at offset <strong>@faultedOffset</strong>@(subscription.Spec.Partition == null ? " of the stream" : $" of partition '{subscription.Spec.Partition.Id}'").</text>
                    }
                    else
                    {
                        <text>The event that caused the fault is unknown: the fault did not come from a delivery.</text>
                    }
                </p>
                <div class="d-flex flex-wrap gap-2">
                    @if (faultedOffset.HasValue)
                    {
                        <button type="button" class="btn btn-sm btn-light" @onclick="() => ShowEventAsync(faultedOffset.Value)"><i class="bi bi-eye" aria-hidden="true"></i> Show the event</button>
                    }
                    @if (canOperate)
                    {
                        <button type="button" class="btn btn-sm btn-primary" @onclick="RetryAsync" title="Clear the fault and deliver the event again"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Retry this event</button>
                        @if (faultedOffset.HasValue)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger bg-body" @onclick="() => SkipAsync(faultedOffset.Value)" title="Never deliver the event, and resume with the next one"><i class="bi bi-skip-forward-fill" aria-hidden="true"></i> Skip this event</button>
                        }
                    }
                </div>
            </section>
        }

        <div class="row g-3 mb-3">
            <div class="col-lg-6">
                <section class="card h-100" aria-labelledby="state-title">
                    <div class="card-header"><h3 id="state-title" class="h6 mb-0">State</h3></div>
                    <div class="card-body">
                        <dl class="row small mb-0">
                            <dt class="col-5">Subscriber</dt>
                            <dd class="col-7 text-break"><DeliveryTargetDisplay Endpoint="subscription.Spec.Subscriber.Endpoint" Sink="@subscription.Spec.Subscriber.Sink" /></dd>
                            <dt class="col-5">Subscriber state</dt>
                            <dd class="col-7">
                                @SubscriberBadge(subscription.Status?.Subscriber?.State ?? SubscriberState.Unknown)
                                @if (!string.IsNullOrWhiteSpace(subscription.Status?.Subscriber?.Reason))
                                {
                                    <div class="text-secondary text-break">@subscription.Status.Subscriber.Reason</div>
                                }
                            </dd>
                            <dt class="col-5">Consumes</dt>
                            <dd class="col-7 text-break">
                                @if (subscription.Spec.Partition == null)
                                {
                                    <text>the whole stream</text>
                                }
                                else
                                {
                                    <a href="@($"events?partitionType={subscription.Spec.Partition.Type}&partitionId={Uri.EscapeDataString(subscription.Spec.Partition.Id)}&namespace={Uri.EscapeDataString(SubscriptionNamespace)}")">@subscription.Spec.Partition.Type '@subscription.Spec.Partition.Id'</a>
                                }
                            </dd>
                            <dt class="col-5">Tracks an offset</dt>
                            <dd class="col-7">@(subscription.Spec.Stream == null ? "no: only events published while it is active are delivered" : "yes")</dd>
                            @if (subscription.Spec.Stream != null)
                            {
                                <dt class="col-5">Acknowledged offset</dt>
                                <dd class="col-7">@(subscription.Status?.Stream?.AckedOffset?.ToString() ?? "none yet")</dd>
                                <dt class="col-5">Lag</dt>
                                <dd class="col-7">
                                    @if (health?.Lag is ulong lag)
                                    {
                                        @if (lag > 0)
                                        {
                                            <span class="badge text-bg-warning">behind by @lag.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span>up to date</span>
                                        }
                                        <span class="text-secondary"> of @health.PartitionLength?.ToString("N0") events</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">unknown</span>
                                    }
                                </dd>
                            }
                            <dt class="col-5">Last acknowledged</dt>
                            <dd class="col-7">@(subscription.Status?.Subscriber?.LastAcknowledgedAt?.LocalDateTime.ToString("G") ?? "never")</dd>
                            <dt class="col-5">Dead letters</dt>
                            <dd class="col-7">@(subscription.Spec.DeadLetter == null ? "no: failed deliveries fault the subscription" : !subscription.Spec.DeadLetter.IsForwarded ? "stored" : $"sent to {DeliveryTargetDisplay.Describe(subscription.Spec.DeadLetter.Endpoint, subscription.Spec.DeadLetter.Sink)}")</dd>
                        </dl>
                    </div>
                </section>
            </div>
            <div class="col-lg-6">
                <section class="card h-100" aria-labelledby="pending-title">
                    <div class="card-header"><h3 id="pending-title" class="h6 mb-0">Pending acknowledgement</h3></div>
                    <div class="card-body small">
                        @if (pendingAck == null)
                        {
                            <p class="text-secondary mb-0">None: the subscriber has not deferred the acknowledgement of an event.</p>
                        }
                        else
                        {
                            <p class="mb-2">The subscriber accepted the event at offset <strong>@pendingAck.Offset</strong> and will acknowledge it later. Delivery waits until then.</p>
                            <p class="mb-2">
                                @if (pendingAck.ExpiresAt <= DateTimeOffset.UtcNow)
                                {
                                    <span class="badge text-bg-danger"><i class="bi bi-hourglass-bottom" aria-hidden="true"></i> expired</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning"><i class="bi bi-hourglass-split" aria-hidden="true"></i> pending</span>
                                }
                                expires at @pendingAck.ExpiresAt.LocalDateTime.ToString("G")
                            </p>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ShowEventAsync(pendingAck.Offset)"><i class="bi bi-eye" aria-hidden="true"></i> Show the event</button>
                        }
                    </div>
                </section>
            </div>
        </div>

        @if (subscription.Spec.Stream != null)
        {
            <section class="card mb-3" aria-labelledby="activity-title">
                <div class="card-header d-flex justify-content-between align-items-baseline">
                    <h3 id="activity-title" class="h6 mb-0">Activity</h3>
                    <span class="small text-secondary">sampled every @RefreshInterval.TotalSeconds seconds since this page was opened</span>
                </div>
                <div class="card-body row g-4">
                    <div class="col-lg-6">
                        <TimeSeriesChart Title="Lag (events)" Kind="TimeSeriesChartKind.Line" YTitle="Lag" EmptyMessage="Waiting for the first samples..."
                                         Points="@(history.Samples.Where(s => s.Lag.HasValue).Select(s => new ChartPoint(s.At.LocalDateTime.ToString("T"), s.Lag!.Value)).ToList())" />
                    </div>
                    <div class="col-lg-6">
                        <TimeSeriesChart Title="Acknowledgement rate (events per minute)" Kind="TimeSeriesChartKind.Line" YTitle="Events per minute" EmptyMessage="Waiting for two samples..."
                                         Format="@(v => v.ToString("N1", CultureInfo.CurrentCulture))"
                                         Points="@(history.GetAckRates().Select(r => new ChartPoint(r.At.LocalDateTime.ToString("T"), r.PerMinute)).ToList())" />
                    </div>
                </div>
            </section>
        }

        <section class="card mb-3" aria-labelledby="failures-title">
            <div class="card-header"><h3 id="failures-title" class="h6 mb-0">Failure history</h3></div>
            <div class="card-body small">
                @if (subscription.Spec.DeadLetter == null)
                {
                    <p class="text-secondary mb-0">The subscription has no dead-letter policy, so it keeps no history of failures: an event that cannot be delivered faults it instead, as shown above.</p>
                }
                else if (subscription.Spec.DeadLetter.IsForwarded)
                {
                    <p class="text-secondary mb-0">Events that cannot be delivered are sent to <span class="text-break"><DeliveryTargetDisplay Endpoint="subscription.Spec.DeadLetter.Endpoint" Sink="@subscription.Spec.DeadLetter.Sink" /></span>, which keeps their history.</p>
                }
                else if (deadLetters == null)
                {
                    <div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
                }
                else if (deadLetters.Count == 0)
                {
                    <p class="text-secondary mb-0">No event has failed to be delivered.</p>
                }
                else
                {
                    <p class="text-secondary">The events that could not be delivered and have been set aside, most recent first@(deadLetters.Count >= DeadLetterPageSize ? $" (the {DeadLetterPageSize} most recent)" : "").</p>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <caption class="visually-hidden">Dead letters of the subscription</caption>
                            <thead>
                                <tr>
                                    <th scope="col">When</th>
                                    <th scope="col">Event offset</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Reason</th>
                                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var deadLetter in deadLetters)
                                {
                                    <tr>
                                        <td class="text-nowrap">@deadLetter.DeadLetteredAt.LocalDateTime.ToString("G")</td>
                                        <td>@deadLetter.EventOffset</td>
                                        <td class="text-break">@deadLetter.Event.Type</td>
                                        <td class="text-break">@(deadLetter.Reason.Detail ?? deadLetter.Reason.Title)</td>
                                        <td class="text-end text-nowrap">
                                            @if (canOperate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => RedeliverDeadLetterAsync(deadLetter)" aria-label="@($"Redeliver the dead letter of the event at offset {deadLetter.EventOffset}")">Redeliver</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

        <div class="card mb-3">
            <div class="card-body">
                <SubscriptionTester @key="Name" Id="playground" Spec="subscription.Spec" Partition="subscription.Spec.Partition" Namespace="@SubscriptionNamespace" />
            </div>
        </div>
    }
</div>

<Offcanvas @ref="offcanvas" Size="OffcanvasSize.Large" UseStaticBackdrop="false" />
<ConfirmDialog @ref="dialog" />

@code {

    /// <summary>
    /// Gets the interval at which the subscription is refreshed and sampled
    /// </summary>
    static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    const int DeadLetterPageSize = 20;

    readonly CancellationTokenSource cancellation = new();
    SubscriptionSampleHistory history = new();
    Subscription? subscription;
    SubscriptionHealth? health;
    IReadOnlyList<DeadLetter>? deadLetters;
    bool notFound;
    bool canOperate;
    Offcanvas? offcanvas;
    ConfirmDialog? dialog;
    string? loadedName;

    /// <summary>
    /// Gets/sets the name of the subscription to show
    /// </summary>
    [Parameter] public string Name { get; set; } = null!;

    /// <summary>
    /// Gets/sets the namespace of the subscription, which defaults to the default namespace (see #215)
    /// </summary>
    [Parameter] public string? Namespace { get; set; }

    string SubscriptionNamespace => string.IsNullOrWhiteSpace(this.Namespace) ? Neuroglia.Data.Infrastructure.ResourceOriented.Namespace.DefaultNamespaceName : this.Namespace;

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        canOperate = await UserAccess.CanOperateAsync(SubscriptionNamespace);
        _ = RefreshLoopAsync(cancellation.Token);
    }

    /// <inheritdoc/>
    protected override async Task OnParametersSetAsync()
    {
        if (loadedName == $"{SubscriptionNamespace}/{Name}") return;
        loadedName = $"{SubscriptionNamespace}/{Name}";
        subscription = null;
        // the page is reused when navigating from a subscription to another: nothing of the previous one is kept
        history = new();
        health = null;
        deadLetters = null;
        notFound = false;
        await RefreshAsync(true);
    }

    async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshAsync(false);
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
    }

    /// <summary>
    /// Gets the subscription, its health and, if asked to, its dead letters, then samples its lag and acknowledged offset
    /// </summary>
    async Task RefreshAsync(bool includeDeadLetters)
    {
        var name = Name;
        try
        {
            subscription = await Api.Resources.Subscriptions.GetAsync(name, SubscriptionNamespace);
            notFound = false;
        }
        catch (ProblemDetailsException ex) when (ex.Problem.Status == 404)
        {
            notFound = true;
            return;
        }
        catch (Exception) when (subscription != null)
        {
            // a failed refresh keeps what is shown
            return;
        }
        try { health = (await Api.Resources.Subscriptions.GetHealthAsync(null, SubscriptionNamespace)).FirstOrDefault(h => h.Name == name); }
        catch (Exception) { health = null; }
        history.Add(new(DateTimeOffset.Now, health?.Lag, subscription.Spec.Stream == null ? null : subscription.Status?.Stream?.AckedOffset));
        if (includeDeadLetters || (deadLetters == null && subscription.Spec.DeadLetter?.IsForwarded != true)) await LoadDeadLettersAsync();
    }

    async Task LoadDeadLettersAsync()
    {
        if (subscription?.Spec.DeadLetter == null || subscription.Spec.DeadLetter.IsForwarded) return;
        try { deadLetters = await Api.Resources.Subscriptions.GetDeadLettersAsync(Name, length: DeadLetterPageSize, @namespace: SubscriptionNamespace); }
        catch (Exception) { deadLetters = []; }
    }

    async Task ShowEventAsync(ulong offset)
    {
        if (offcanvas == null || subscription == null) return;
        var partition = subscription.Spec.Partition;
        CloudEvent? e = null;
        try
        {
            var options = new StreamReadOptions(StreamReadDirection.Forwards, (long)offset, 1) { Partition = partition };
            await foreach (var item in await Api.CloudEvents.Stream.ReadStreamAsync(options, SubscriptionNamespace)) { e = item; break; }
        }
        catch (Exception ex)
        {
            Notify(ToastType.Danger, $"Failed to read the event at offset {offset}: {Describe(ex)}");
            return;
        }
        if (e == null)
        {
            Notify(ToastType.Warning, $"There is no event at offset {offset}");
            return;
        }
        var parameters = new Dictionary<string, object>() { ["ReadOnly"] = true, ["CloudEvent"] = e, ["Offset"] = (ulong?)offset };
        if (partition != null) parameters["Partition"] = partition;
        await offcanvas.ShowAsync<CloudEventDetails>(title: $"Event at offset {offset}", parameters: parameters);
    }

    async Task RetryAsync()
    {
        if (dialog == null || !await dialog.ShowAsync(title: $"Retry the event that faulted '{Name}'?", message1: "The fault is cleared, and the event is delivered again. If it fails again, the subscription is faulted again.",
            confirmDialogOptions: new ConfirmDialogOptions() { YesButtonText = "Retry", NoButtonText = "Cancel", IsVerticallyCentered = true })) return;
        await RunAsync(() => Api.Resources.Subscriptions.ResumeAsync(Name, SubscriptionNamespace), "The fault has been cleared: the event is being delivered again", "Failed to retry the event");
    }

    async Task SkipAsync(ulong offset)
    {
        if (dialog == null || !await dialog.ShowAsync(title: $"Skip the event at offset {offset}?", message1: "The event is never delivered to the subscriber: delivery resumes with the next one.",
            message2: subscription?.Spec.DeadLetter == null ? "The subscription has no dead-letter policy: the event is not set aside either." : "The event is not dead-lettered either.",
            confirmDialogOptions: new ConfirmDialogOptions() { YesButtonText = "Skip", YesButtonColor = ButtonColor.Danger, NoButtonText = "Cancel", IsVerticallyCentered = true })) return;
        await RunAsync(() => Api.Resources.Subscriptions.SkipAsync(Name, offset, SubscriptionNamespace), $"The event at offset {offset} has been skipped", "Failed to skip the event");
    }

    async Task SuspendAsync()
    {
        if (dialog == null || !await dialog.ShowAsync(title: $"Suspend subscription '{Name}'?", message1: "Nothing is delivered to the subscriber until the subscription is resumed.",
            confirmDialogOptions: new ConfirmDialogOptions() { YesButtonText = "Suspend", YesButtonColor = ButtonColor.Warning, NoButtonText = "Cancel", IsVerticallyCentered = true })) return;
        await RunAsync(() => Api.Resources.Subscriptions.SuspendAsync(Name, SubscriptionNamespace), $"The subscription '{Name}' has been suspended", "Failed to suspend the subscription");
    }

    Task ResumeAsync() => RunAsync(() => Api.Resources.Subscriptions.ResumeAsync(Name, SubscriptionNamespace), $"The subscription '{Name}' has been resumed", "Failed to resume the subscription");

    async Task RedeliverDeadLetterAsync(DeadLetter deadLetter)
    {
        try
        {
            var redelivery = await Api.Resources.Subscriptions.RedeliverDeadLetterAsync(Name, deadLetter.Offset, SubscriptionNamespace);
            Notify(ToastType.Success, $"The event at offset {deadLetter.EventOffset} has been redelivered (status {redelivery.Status})");
        }
        catch (Exception ex)
        {
            Notify(ToastType.Danger, $"Failed to redeliver the event at offset {deadLetter.EventOffset}: {Describe(ex)}");
        }
    }

    async Task RunAsync(Func<Task<Subscription>> operation, string success, string failure)
    {
        try
        {
            subscription = await operation();
            Notify(ToastType.Success, success);
        }
        catch (Exception ex)
        {
            Notify(ToastType.Danger, $"{failure}: {Describe(ex)}");
        }
    }

    void Notify(ToastType type, string message) => ToastService.Notify(new(type, message));

    static string Describe(Exception ex) => ex is ProblemDetailsException problem ? problem.Problem.Detail ?? problem.Problem.Title : ex.Message;

    static RenderFragment PhaseBadge(Subscription subscription) => __builder =>
    {
        if (subscription.Status?.Stream?.Fault != null)
        {
            <span class="badge text-bg-danger"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> faulted</span>
        }
        else if (subscription.Spec.Suspended || subscription.Status?.Phase == SubscriptionStatusPhase.Suspended)
        {
            <span class="badge text-bg-warning"><i class="bi bi-pause-circle" aria-hidden="true"></i> suspended</span>
        }
        else if (subscription.Status?.Phase == SubscriptionStatusPhase.Active)
        {
            <span class="badge text-bg-success"><i class="bi bi-check-circle" aria-hidden="true"></i> active</span>
        }
        else
        {
            <span class="badge text-bg-secondary"><i class="bi bi-dash-circle" aria-hidden="true"></i> inactive</span>
        }
    };

    static RenderFragment SubscriberBadge(SubscriberState state) => __builder =>
    {
        switch (state)
        {
            case SubscriberState.Reachable:
                <span class="badge text-bg-success"><i class="bi bi-check-circle" aria-hidden="true"></i> reachable</span>
                break;
            case SubscriberState.Unreachable:
                <span class="badge text-bg-danger"><i class="bi bi-x-octagon" aria-hidden="true"></i> unreachable</span>
                break;
            default:
                <span class="badge text-bg-secondary"><i class="bi bi-question-circle" aria-hidden="true"></i> unknown</span>
                break;
        }
    };

    /// <inheritdoc/>
    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }

}
