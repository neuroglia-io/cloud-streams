@namespace CloudStreams.Dashboard.Components
@implements IDisposable
@inject NamespaceContext NamespaceContext
@inject NavigationManager NavigationManager

@* Selects the namespace the dashboard shows the resources and cloud events of. A 'namespace' query parameter, as in links from a subscription to its events, selects
   the namespace it names (see #215) *@

<div class="me-3 d-flex align-items-center">
    <label for="namespace-selector" class="visually-hidden">Namespace</label>
    <select id="namespace-selector" class="form-select form-select-sm" value="@(selected ?? string.Empty)" @onchange="OnChanged" title="The namespace whose resources and cloud events are shown">
        <option value="">All namespaces</option>
        @foreach (var ns in namespaces)
        {
            <option value="@ns">@ns</option>
        }
    </select>
</div>

@code {

    IReadOnlyList<string> namespaces = [];
    string? selected;
    readonly List<IDisposable> subscriptions = [];

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        this.subscriptions.Add(this.NamespaceContext.Namespaces.Subscribe(namespaces => this.InvokeAsync(() =>
        {
            this.namespaces = namespaces;
            this.StateHasChanged();
        })));
        this.subscriptions.Add(this.NamespaceContext.Selected.Subscribe(selected => this.InvokeAsync(() =>
        {
            this.selected = selected;
            this.StateHasChanged();
        })));
        this.NavigationManager.LocationChanged += this.OnLocationChanged;
        this.SelectFromQuery(this.NavigationManager.Uri);
        await this.NamespaceContext.RefreshAsync();
    }

    void OnChanged(ChangeEventArgs e) => this.NamespaceContext.Select(e.Value?.ToString());

    void OnLocationChanged(object? sender, LocationChangedEventArgs e) => this.SelectFromQuery(e.Location);

    void SelectFromQuery(string location)
    {
        var query = new Uri(location).Query;
        if (string.IsNullOrEmpty(query)) return;
        foreach (var parameter in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = parameter.IndexOf('=');
            if (separator < 0 || Uri.UnescapeDataString(parameter[..separator]) != "namespace") continue;
            var value = Uri.UnescapeDataString(parameter[(separator + 1)..]);
            if (!string.IsNullOrWhiteSpace(value)) this.NamespaceContext.Select(value);
            return;
        }
    }

    /// <inheritdoc/>
    public void Dispose()
    {
        this.NavigationManager.LocationChanged -= this.OnLocationChanged;
        foreach (var subscription in this.subscriptions) subscription.Dispose();
    }

}
