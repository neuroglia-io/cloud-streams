<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<VersionPrefix>0.86.0</VersionPrefix>
	<AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
	<FileVersion>$(VersionPrefix)</FileVersion>
	<NeutralLanguage>en</NeutralLanguage>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<IsPackable>true</IsPackable>
	<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	<Copyright>Copyright © 2023-Present The Cloud Streams Authors. All rights reserved.</Copyright>
	<PackageProjectUrl>https://github.com/neuroglia-io/cloud-streams</PackageProjectUrl>
	<RepositoryUrl>https://github.com/neuroglia-io/cloud-streams</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<DockerFileTag>cloud-streams/api</DockerFileTag>
	<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	<DockerfileContext>..\..\..</DockerfileContext>
	<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	<!-- the package is referenced as a library, by the gateway: the content of the application, such as the WebAssembly debugging proxy, does not belong in it -->
	<IncludeContentInPack>false</IncludeContentInPack>
	<!-- OpenTelemetry.Instrumentation.StackExchangeRedis has no stable release yet -->
	<NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
	<PackageReference Include="EventStore.Client.Extensions.OpenTelemetry" Version="23.3.9" />
	<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
	<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.21" />
	<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.21" />
	<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.21" />
	<PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="9.0.21" />
	<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.2" />
	<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
	<PackageReference Include="Neuroglia.Data.Infrastructure.EventSourcing.EventStore" Version="4.24.0" />
	<!-- pinned above the version Neuroglia references, which accepts certificates from any CA (GHSA-w7r3-mgwf-4mqq) -->
	<PackageReference Include="KubernetesClient" Version="17.0.14" />
	<PackageReference Include="Neuroglia.Data.Infrastructure.ResourceOriented.Kubernetes" Version="4.24.0" />
	<PackageReference Include="Neuroglia.Data.Infrastructure.ResourceOriented.Redis" Version="4.24.0" />
	<PackageReference Include="Neuroglia.Mediation.AspNetCore" Version="4.24.0" />
	<PackageReference Include="Neuroglia.Data.Expressions.JQ" Version="4.24.0" />
	<PackageReference Include="Neuroglia.Security.AspNetCore" Version="4.24.0" />
	<PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.12.0-beta.1" />
	<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="9.0.1" />
	<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.0.1" />
	<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
	<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.12.0" />
	<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
	<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
  </ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\CloudStreams.Core.Api.Client\CloudStreams.Core.Api.Client.csproj" />
    <ProjectReference Include="..\CloudStreams.Core.Application\CloudStreams.Core.Application.csproj" />
  </ItemGroup>

</Project>
