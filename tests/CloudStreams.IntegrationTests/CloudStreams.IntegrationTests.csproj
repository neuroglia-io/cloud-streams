<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
    <Copyright>Copyright © 2023-Present The Cloud Streams Authors. All rights reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Testcontainers.K3s" Version="4.17.0" />
    <PackageReference Include="Testcontainers.Kafka" Version="4.17.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.17.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\core\CloudStreams.Core.Api.Client\CloudStreams.Core.Api.Client.csproj" />
    <!-- referenced for its Redis database, which is tested against a real Redis -->
    <ProjectReference Include="..\..\src\core\CloudStreams.Core.Api\CloudStreams.Core.Api.csproj" />
    <ProjectReference Include="..\..\src\operator\CloudStreams.Operator\CloudStreams.Operator.csproj" />
    <!-- referenced for its rate limiter and deduplicator, which are tested against a real Redis -->
    <ProjectReference Include="..\..\src\gateway\CloudStreams.Gateway.Application\CloudStreams.Gateway.Application.csproj" />
    <!-- The gateway and the broker run as child processes, started from their build output: they are built with the tests, but not referenced -->
    <ProjectReference Include="..\..\src\gateway\CloudStreams.Gateway.Api\CloudStreams.Gateway.Api.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\broker\CloudStreams.Broker.Api\CloudStreams.Broker.Api.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
